<mxfile host="app.diagrams.net"><diagram id="section-1" name="一、从程序中的字节到线上波形"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;应用字节&#10;例如 0x41" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;发送寄存器&#10;等待外设取走" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;移位器&#10;起始、数据、停止位" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;TX 物理线路&#10;按波特率变化" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="6" value="05&#10;对端 RX 采样&#10;还原位和字节" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="7" value="06&#10;接收缓冲&#10;交给协议处理" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-2" name="二、8N1 的一帧怎样数时间"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;空闲高&#10;等待发送" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;起始位低&#10;建立帧起点" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;8 个数据位&#10;通常低位先发" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;无校验 N&#10;本例不额外校验" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="6" value="05&#10;1 个停止位&#10;回到高电平" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="7" value="06&#10;下一帧或空闲&#10;总计 10 个位时间" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-3" name="三、接收字节流必须有组包状态机"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;等待帧头&#10;丢弃无关字节" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=