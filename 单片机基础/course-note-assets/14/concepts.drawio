<mxfile host="app.diagrams.net"><diagram id="section-1" name="一、先画存储布局，再写参数"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;用户 Flash&#10;程序与常量" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;链接布局&#10;明确代码占用" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;专用数据页&#10;避免覆盖程序" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;擦除一整页&#10;不是只删一个变量" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="6" value="05&#10;半字编程&#10;满足对齐与状态" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="7" value="06&#10;读回检查&#10;核对保存结果" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-2" name="二、解锁到重新上锁是一段受控操作"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;检查参数&#10;地址、对齐、长度" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;解锁&#10;写入规定密钥" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;等待不忙&#10;检查状态与超时" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;擦除/编程&#10;限定目标范围" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="6" value="05&#10;状态与读回&#10;确认本次操作" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="7" value="06&#10;重新上锁&#10;发布结果" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-3" name="三、BKP 保存依赖备份域供电"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;VDD 正常供电&#10;系统与后备域工作" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#e