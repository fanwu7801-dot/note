<mxfile host="app.diagrams.net"><diagram id="hardware-pipeline" name="硬件时间链：触发、搬运、计算、装载各有边界"><mxGraphModel page="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b0" vertex="1" parent="1" value="定时器事件&#10;确定采样相位" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="50" y="162.0" width="270" height="108.0" /></mxCell><mxCell id="b1" vertex="1" parent="1" value="ADC采样与转换&#10;随后DMA形成数据块" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="162.0" width="270" height="108.0" /></mxCell><mxCell id="b2" vertex="1" parent="1" value="ISR通知任务&#10;等待调度与计算" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="162.0" width="270" height="108.0" /></mxCell><mxCell id="b3" vertex="1" parent="1" value="写CCR预装载&#10;等待有效更新" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="450.0" width="270" height="117.0" /></mxCell><mxCell id="b4" vertex="1" parent="1" value="输出引脚与驱动&#10;产生真实动作" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="450.0" width="270" height="117.0" /></mxCell><mxCell id="e0" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="320" y="216.0" /><mxPoint as="targetPoint" x="410" y="216.0" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="680" y="216.0" /><mxPoint as="targetPoint" x="770" y="216.0" /></mxGeometry></mxCell><mxCell id="e2" ed