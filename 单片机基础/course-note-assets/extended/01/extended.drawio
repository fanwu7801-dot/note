<mxfile host="app.diagrams.net"><diagram id="address-decode" name="一次写 GPIOA_ODR 的地址怎样形成"><mxGraphModel page="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b0" vertex="1" parent="1" value="GPIOA 基地址&#10;0x40010800" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="50" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b1" vertex="1" parent="1" value="ODR 偏移&#10;+0x0C" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b2" vertex="1" parent="1" value="有效地址&#10;0x4001080C" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b3" vertex="1" parent="1" value="总线地址译码&#10;选 GPIOA 的 ODR" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="b4" vertex="1" parent="1" value="写入锁存值&#10;再受引脚模式约束" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="e0" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="320" y="211.5" /><mxPoint as="targetPoint" x="410" y="211.5" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="680" y="211.5" /><mxPoint as="targetPoint" x="770" y="211.5" /></mxGeometry></mxCell><mxCell id="e2" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="905.0" y="270" /><mxPoint as="targetPoint" x="905.0" y="423.0" /></mxGeometry></mxCell><mxCell id="e3" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="770" y="481.5" /><mxPoint as="targetPoint" x="680" y="481.5" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="c-startup" name="进入 main 之前，初值和零值从哪里来"><mxGraphModel page="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b0" vertex="1" parent="1" value="Flash&#10;.data 的初值映像" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="50" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b1" vertex="1" parent="1" value="启动代码复制&#10;Flash → SRAM" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b2" vertex="1" parent="1" value="SRAM&#10;.data 取得初值" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b3" vertex="1" parent="1" value="启动代码&#10;将 .bss 清零" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="b4" vertex="1" parent="1" value="C 运行环境就绪&#10;进入 main" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="e0" edge="1" parent=