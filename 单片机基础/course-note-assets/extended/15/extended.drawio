<mxfile host="app.diagrams.net"><diagram id="timezone" name="UTC存储只做一次时区转换，避免重复加8小时"><mxGraphModel page="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b0" vertex="1" parent="1" value="UTC时间戳&#10;对应UTC 00:00" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="50" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b1" vertex="1" parent="1" value="显示层转UTC+8&#10;显示08:00" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b2" vertex="1" parent="1" value="用户输入本地08:00&#10;明确其时区" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b3" vertex="1" parent="1" value="转换回UTC 00:00&#10;再写入存储" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="e0" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="320" y="211.5" /><mxPoint as="targetPoint" x="410" y="211.5" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="680" y="211.5" /><mxPoint as="targetPoint" x="770" y="211.5" /></mxGeometry></mxCell><mxCell id="e2" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="905.0" y="270" /><mxPoint as="targetPoint" x="905.0" y="423.0" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="rtc-trust" name="启动时先判断时间可信度，再决定是否初始化"><mxGraphModel page="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b0" vertex="1" parent="1" value="启动读取备份状态&#10;电源/复位原因" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="50" y="288.0" width="270" height="117.0" /></mxCell><mxCell id="b1" vertex="1" parent="1" value="检查配置标记&#10;RTC运行与数值范围" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="288.0" width="270" height="117.0" /></mxCell><mxCell id="b2" vertex="1" parent="1" value="可信：保留计时&#10;不重复写默认日期" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="153.0" width="306.0" height="117.0" /></mxCell><mxCell id="b3" vertex="1" parent="1" value="不可信：标为待校时&#10;按受控路径设时间" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="423.0" width="306.0" height="117.0" /></mxCell><mxCell id="e0" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="320" y="346.5" /><mxPoint as="targetPoint" x="410" y="346.5" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="680" y="346.5" /><mxPoint as="targetPoint" x="770" y="211.5" /><Array as="points"><mxPoint x="725.0" y="346.5" /><mxPoint x="725.0" y="211.5" /></Array></mxGeometry></mxCell><mxCell id="e2" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="725.0" y="346.5" /><mxPoint as="targetPo