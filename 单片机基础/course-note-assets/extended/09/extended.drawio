<mxfile host="app.diagrams.net"><diagram id="card-presence" name="卡离场会打断一次交易，重新进场应重新建会话"><mxGraphModel page="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b0" vertex="1" parent="1" value="寻卡/防冲突&#10;选定目标卡" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="50" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b1" vertex="1" parent="1" value="认证指定扇区&#10;建立访问条件" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b2" vertex="1" parent="1" value="读写/业务校验&#10;随时可能卡离场" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b3" vertex="1" parent="1" value="超时或链路丢失&#10;终止当前会话" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="b4" vertex="1" parent="1" value="重新寻卡&#10;重新认证并核对结果" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="e0" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="320" y="211.5" /><mxPoint as="targetPoint" x="410" y="211.5" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="680" y="211.5" /><mxPoint as="targetPoint" x="770" y="211.5" /></mxGeometry></mxCell><mxCell id="e2" edge="1" par