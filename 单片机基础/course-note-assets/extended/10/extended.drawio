<mxfile host="app.diagrams.net"><diagram id="ble-layers" name="BLE 的连接角色与 GATT 数据角色处在不同层"><mxGraphModel page="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b0" vertex="1" parent="1" value="GAP层建立连接&#10;Central / Peripheral" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="50" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b1" vertex="1" parent="1" value="连接上承载ATT&#10;协商可用MTU等能力" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b2" vertex="1" parent="1" value="GATT组织数据&#10;服务/特征/描述符" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b3" vertex="1" parent="1" value="Client 发起访问&#10;Server 提供属性" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="b4" vertex="1" parent="1" value="业务协议&#10;定义含义与完成条件" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="e0" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="320" y="211.5" /><mxPoint as="targetPoint" x="410" y="211.5" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="680" y="211.5" /><mxPoint as="targetPoint" x="770" y="211.5" /></mxGeometry><