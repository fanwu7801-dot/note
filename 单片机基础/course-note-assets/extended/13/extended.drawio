<mxfile host="app.diagrams.net"><diagram id="spi-lock" name="共享总线的锁需要覆盖配置、CS与整段收发"><mxGraphModel page="1" pageWidth="1400" pageHeight="850"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="b0" vertex="1" parent="1" value="取得总线互斥锁&#10;检查设备是否就绪" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="50" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b1" vertex="1" parent="1" value="配置本设备参数&#10;CPOL/CPHA/速度" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b2" vertex="1" parent="1" value="拉低本设备CS&#10;发送命令与数据" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="153.0" width="270" height="117.0" /></mxCell><mxCell id="b3" vertex="1" parent="1" value="等待传输真正结束&#10;检查BSY等条件" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="770" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="b4" vertex="1" parent="1" value="释放CS再解锁&#10;错误路径也需收尾" style="whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="410" y="423.0" width="270" height="117.0" /></mxCell><mxCell id="e0" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="320" y="211.5" /><mxPoint as="targetPoint" x="410" y="211.5" /></mxGeometry></mxCell><mxCell id="e1" edge="1" parent="1" style="endArrow=classic;strokeColor=#2563a6;strokeWidth=2;"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="680" y="211.5" /><mxPoint as="targetPoint" x="770" y="211.5" /></mxGeometry></mxCell><mxCell id="e2" ed