<mxfile host="app.diagrams.net"><diagram id="section-1" name="一、电压怎样变成一个数字"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;模拟输入&#10;传感器输出电压" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;采样与保持&#10;等待电容建立" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;逐次逼近转换&#10;量化为 12 位" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;ADC_DR&#10;保存转换结果" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="6" value="05&#10;软件或 DMA&#10;取走数据" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="7" value="06&#10;电压与业务量&#10;缩放、标定、判定" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-2" name="二、扫描与连续是两项独立选择"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="