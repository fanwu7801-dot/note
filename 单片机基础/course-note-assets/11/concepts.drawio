<mxfile host="app.diagrams.net"><diagram id="section-1" name="一、三种角色的责任不同"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;协调器&#10;建立与管理网络" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;路由器&#10;转发网络数据" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;终端设备&#10;连接父节点" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;休眠策略&#10;终端按需唤醒" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="6" value="05&#10;无线链路&#10;受距离和干扰影响" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="7" value="06&#10;应用消息&#10;仍需结果确认" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-2" name="二、组网参数与串口参数分层核对"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;UART 波特率&#10;本地字节传送" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;无线信道&#10;选择射频频段" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;PAN 标识&#10;区分网络" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;节点角色&#10;建网或加入" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="6" value="05&#10;地址与目标&#10;决定消息投递" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="7" value="06&#10;状态与应答&#10;确认实际结果" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="850.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-3" name="三、可靠性需要把超时与重复消息算进去"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;采集输入&#10;形成待发数据" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;stro