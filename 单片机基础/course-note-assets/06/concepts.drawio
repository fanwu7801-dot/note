<mxfile host="app.diagrams.net"><diagram id="section-1" name="补图一：PSC 把密集时钟变成较慢计数节拍"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;输入时钟 fTIM&#10;每秒 7200 万拍" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;PSC = 7199&#10;累计 7200 拍" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;计数节拍 fCNT&#10;每秒 10000 拍" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;每拍 0.1 ms&#10;驱动 CNT 加 1" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-2" name="补图二：到 ARR 不是立刻跳过这一格"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;CNT = 8&#10;保持一个刻度" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;下一拍 CNT = 9&#10;仍保持一个刻度" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;再下一拍 CNT = 0&#10;发生溢出更新" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;进入新一轮&#10;继续 1、2、…" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-3" name="补图三：更新事件与中断之间隔着控制开关"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;溢出更新 UEV&#10;也可装载预装载值" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;SR.UIF&#10;保存更新标志" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;DIER.UIE&#10;允许更新中断请求" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;NVIC 与 CPU&#10;允许后进入 ISR" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-4" name="补图四：输出比较的三个决定因素"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;CNT&#10;当前走到的位置" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;CCR1&#10;比较阈值" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;PWM1 与极性&#10;决定有效区间" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;输出使能与 GPIO&#10;决定是否到达引脚" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram><diagram id="section-5" name="补图五：预装载把新旧两套参数分开"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="01&#10;软件写 CCR = 7&#10;写入预装载值" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="3" value="02&#10;当前有效 CCR = 3&#10;本轮继续旧脉宽" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf7ef;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="45.0" width="365.0" height="185.0" /></mxCell><mxCell id="4" value="03&#10;正常更新事件 UEV&#10;把新值装载生效" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#fff3df;strokeColor=#2563a6;"><mxGeometry as="geometry" x="40.0" y="275.0" width="365.0" height="185.0" /></mxCell><mxCell id="5" value="04&#10;有效 CCR = 7&#10;下一轮使用新脉宽" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Microsoft YaHei;fontSize=20;fillColor=#eaf3ff;strokeColor=#2563a6;"><mxGeometry as="geometry" x="445.0" y="275.0" width="365.0" height="185.0" /></mxCell></root></mxGraphModel></diagram></mxfile>