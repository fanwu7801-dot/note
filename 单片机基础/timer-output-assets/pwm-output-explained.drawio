hed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="882" y="815" /><mxPoint as="targetPoint" x="1260" y="815" /></mxGeometry></mxCell><mxCell id="98" style="endArrow=none;strokeColor=#13876a;strokeWidth=5;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1260" y="815" /><mxPoint as="targetPoint" x="1260" y="750" /></mxGeometry></mxCell><mxCell id="99" style="endArrow=none;strokeColor=#13876a;strokeWidth=5;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1260" y="750" /><mxPoint as="targetPoint" x="1335" y="750" /></mxGeometry></mxCell><mxCell id="100" value="0、1、2：高" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#13876a;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="191" y="838" width="135.0" height="28" /></mxCell><mxCell id="101" value="3、4、5、6、7、8、9：低" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#65768a;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="389" y="838" width="264.0" height="28" /></mxCell><mxCell id="102" value="新一轮又从高开始" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#13876a;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="753" y="838" width="180.0" height="28" /></mxCell><mxCell id="103" style="endArrow=none;strokeColor=#13876a;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="180" y="898" /><mxPoint as="targetPoint" x="720" y="898" /></mxGeometry></mxCell><mxCell id="104" style="endArrow=none;strokeColor=#13876a;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="180" y="888" /><mxPoint as="targetPoint" x="180" y="908" /></mxGeometry></mxCell><mxCell id="105" style="endArrow=none;strokeColor=#13876a;strokeWidth=2;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="720" y="888" /><mxPoint as="targetPoint" x="720" y="908" /></mxGeometry></mxCell><mxCell id="106" value="一个周期：1 ms，频率：1 kHz" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=23;fontColor=#13876a;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="274" y="911" width="340.0" height="30" /></mxCell><mxCell id="107" style="rounded=1;fillColor=#e6f5ef;strokeColor=#c7d4e2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="972" width="630" height="150" /></mxCell><mxCell id="108" value="这次 CCR1 = 3，得到 30% 占空比" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#172b45;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="56" y="984" width="399.984375" height="32" /></mxCell><mxCell id="109" value="高电平：3 步 × 0.1 ms = 0.3 ms&#10;整个周期：10 步 × 0.1 ms = 1 ms&#10;占空比 = 3 / 10 = 30%" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#172b45;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="56" y="1024" width="337.0" height="84" /></mxCell><mxCell id="110" style="rounded=1;fillColor=#fff1df;strokeColor=#c7d4e2;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="972" width="650" height="150" /></mxCell><mxCell id="111" value="只改变 CCR1，就能改变高电平宽度" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=25;fontColor=#172b45;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="726" y="984" width="409.984375" height="32" /></mxCell><mxCell id="112" value="CCR1 = 2 → 20%    CCR1 = 5 → 50%&#10;CCR1 = 8 → 80%&#10;PSC、ARR 保持不变时，周期仍为 1 ms" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#172b45;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="726" y="1024" width="385.0" height="84" /></mxCell><mxCell id="113" value="③ 实际输出通路" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=26;fontColor=#172b45;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1144" width="202.0" height="33" /></mxCell><mxCell id="114" value="CNT 与 CCR 比较 → CCMR 选择 PWM1 → CCER 使能/极性 → GPIO 复用输出" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#172b45;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1193" width="878.953125" height="31" /></mxCell><mxCell id="115" value="CR1.CEN = 1 让计数开始；相关配置完成后，硬件自动循环输出，无需逐次进入中断。" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#65768a;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1241" width="858.0" height="29" /></mxCell><mxCell id="116" value="读图关键：CNT = 3 时输出已经变低；CNT 仍继续数，回到 0 时输出才再次变高。" style="text;html=0;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=24;fontColor=#2378ce;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1291" width="900.0" height="31" /></mxCell></root></mxGraphModel></diagram></mxfile>