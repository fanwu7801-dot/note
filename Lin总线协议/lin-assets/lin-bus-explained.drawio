        </mxCell>
        <mxCell id="n17" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=24.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700.0" y="192.5" width="161.0" height="56.0" />
        </mxCell>
        <mxCell id="n18" value="bit 3" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="738.5" y="255.5" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n19" value="ID2" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="861.0" y="140.0" width="161.0" height="52.5" />
        </mxCell>
        <mxCell id="n20" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=24.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="861.0" y="192.5" width="161.0" height="56.0" />
        </mxCell>
        <mxCell id="n21" value="bit 2" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="899.5" y="255.5" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n22" value="ID1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1022.0" y="140.0" width="161.0" height="52.5" />
        </mxCell>
        <mxCell id="n23" value="0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=24.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1022.0" y="192.5" width="161.0" height="56.0" />
        </mxCell>
        <mxCell id="n24" value="bit 1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1060.5" y="255.5" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n25" value="ID0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1183.0" y="140.0" width="161.0" height="52.5" />
        </mxCell>
        <mxCell id="n26" value="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=24.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1183.0" y="192.5" width="161.0" height="56.0" />
        </mxCell>
        <mxCell id="n27" value="bit 0" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1221.5" y="255.5" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n28" value="上图按 bit7 → bit0 书写；在线上发送时仍从 bit0 开始" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="416.895" y="303.587" width="566.21" height="36.825" />
        </mxCell>
        <mxCell id="n29" value="P0 = ID0 ⊕ ID1 ⊕ ID2 ⊕ ID4&lt;br&gt;本例：1 ⊕ 0 ⊕ 0 ⊕ 0 = 1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="367.5" width="623.0" height="115.5" />
        </mxCell>
        <mxCell id="n30" value="P1 = NOT(ID1 ⊕ ID3 ⊕ ID4 ⊕ ID5)&lt;br&gt;本例：NOT(0) = 1（仅取 1 bit）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="721.0" y="367.5" width="623.0" height="115.5" />
        </mxCell>
        <mxCell id="n31" value="PID = ID | (P0 &amp;lt;&amp;lt; 6) | (P1 &amp;lt;&amp;lt; 7) = 0x01 | 0x40 | 0x80 = 0xC1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="325.05" y="510.087" width="749.9" height="36.825" />
        </mxCell>
        <mxCell id="n32" value="诊断请求：ID 0x3C → PID 0x3C；诊断响应：ID 0x3D → PID 0x7D。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1d8;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42.0" y="619.5" width="1316.0" height="50.4" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="05-checksum" name="05  校验和：回卷进位求和，再逐位取反">
    <mxGraphModel adaptiveColors="auto" page="1" pageWidth="1400" pageHeight="700" background="#ffffff" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="05  校验和：回卷进位求和，再逐位取反" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=31.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="396.69" y="11.988" width="606.62" height="53.025" />
        </mxCell>
        <mxCell id="n3" value="教学示例：PID = 0xC1，Data = [0x10, 0x20]；增强校验包含 PID。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#526477;fontFamily=Microsoft YaHei;fontSize=17.25;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="390.533" y="60.9" width="618.935" height="35.0" />
        </mxCell>
        <mxCell id="n4" value="Classic 传统校验&lt;br&gt;只计算 Data" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="136.5" width="378.0" height="84.0" />
        </mxCell>
        <mxCell id="n5" value="Enhanced 增强校验&lt;br&gt;计算 PID + Data；不是 6 bit 原始 ID + Data" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="511.0" y="136.5" width="833.0" height="84.0" />
        </mxCell>
        <mxCell id="n6" value="0xC1 + 0x10&lt;br&gt;= 0xD1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="266.0" width="287.0" height="84.0" />
        </mxCell>
        <mxCell id="n7" value="0xD1 + 0x20&lt;br&gt;= 0xF1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="406.0" y="266.0" width="287.0" height="84.0" />
        </mxCell>
        <mxCell id="n8" value="逐位取反&lt;br&gt;保留 8 bit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="756.0" y="266.0" width="287.0" height="84.0" />
        </mxCell>
        <mxCell id="n9" value="Checksum&lt;br&gt;= 0x0E" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1106.0" y="266.0" width="238.0" height="84.0" />
        </mxCell>
        <mxCell id="n10s0" style="endArrow=block;html=1;strokeColor=#243746;strokeWidth=1.9500000000000002;rounded=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="343.0" y="308.0" />
            <mxPoint as="targetPoint" x="406.0" y="308.0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n11s0" style="endArrow=block;html=1;strokeColor=#243746;strokeWidth=1.9500000000000002;rounded=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="693.0" y="308.0" />
            <mxPoint as="targetPoint" x="756.0" y="308.0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n12s0" style="endArrow=block;html=1;strokeColor=#243746;strokeWidth=1.9500000000000002;rounded=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="1043.0" y="308.0" />
            <mxPoint as="targetPoint" x="1106.0" y="308.0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="进位示例：0xF0 + 0x30 = 0x120 → 0x20 + 1 = 0x21 → Checksum = 0xDE" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1d8;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="395.5" width="1288.0" height="73.5" />
        </mxCell>
        <mxCell id="n14" value="接收时，把校验范围内的字节与 Checksum 做同样的回卷求和，结果应为 0xFF" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="333.825" y="485.587" width="732.35" height="36.825" />
        </mxCell>
        <mxCell id="n15" value="本例 Classic：对 0x10 + 0x20 取反得 0xCF，与 Enhanced 的 0x0E 不同" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="345.39" y="532.0" width="709.22" height="35.0" />
        </mxCell>
        <mxCell id="n16" value="ID 0x3C / 0x3D 的诊断帧使用 Classic；校验模型须与版本及帧配置一致。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1d8;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42.0" y="619.5" width="1316.0" height="50.4" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="06-schedule" name="06  调度表：谁发数据由帧定义，何时发由主节点安排">
    <mxGraphModel adaptiveColors="auto" page="1" pageWidth="1400" pageHeight="700" background="#ffffff" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="06  调度表：谁发数据由帧定义，何时发由主节点安排" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=31.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="302.19" y="11.988" width="795.62" height="53.025" />
        </mxCell>
        <mxCell id="n3" value="教学网络：19.2 kbit/s；4 个 10 ms 时隙组成 40 ms 循环。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#526477;fontFamily=Microsoft YaHei;fontSize=17.25;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="422.617" y="60.9" width="554.765" height="35.0" />
        </mxCell>
        <mxCell id="n4" value="0 ms" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="14.0" y="112.0" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n5" value="A_Status&lt;br&gt;ID 0x01 / PID 0xC1&lt;br&gt;2 字节数据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="161.0" width="308.0" height="150.5" />
        </mxCell>
        <mxCell id="n6" value="从 A 发布 → 主 / B 订阅" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.049999999999997;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="94.869" y="329.0" width="230.261" height="35.0" />
        </mxCell>
        <mxCell id="n7" value="10 ms" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="336.0" y="112.0" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n8" value="B_Command&lt;br&gt;ID 0x02 / PID 0x42&lt;br&gt;2 字节数据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="378.0" y="161.0" width="308.0" height="150.5" />
        </mxCell>
        <mxCell id="n9" value="主发布 → 从 B 订阅" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.049999999999997;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="441.747" y="329.0" width="180.506" height="35.0" />
        </mxCell>
        <mxCell id="n10" value="20 ms" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="658.0" y="112.0" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n11" value="A_Status&lt;br&gt;ID 0x01 / PID 0xC1&lt;br&gt;2 字节数据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700.0" y="161.0" width="308.0" height="150.5" />
        </mxCell>
        <mxCell id="n12" value="从 A 发布 → 主 / B 订阅" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.049999999999997;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="738.869" y="329.0" width="230.261" height="35.0" />
        </mxCell>
        <mxCell id="n13" value="30 ms" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="980.0" y="112.0" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n14" value="B_Status&lt;br&gt;ID 0x03 / PID 0x03&lt;br&gt;2 字节数据" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1022.0" y="161.0" width="308.0" height="150.5" />
        </mxCell>
        <mxCell id="n15" value="从 B 发布 → 主订阅" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.049999999999997;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1085.747" y="329.0" width="180.506" height="35.0" />
        </mxCell>
        <mxCell id="n16" value="40 ms" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=16.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1302.0" y="112.0" width="84.0" height="35.0" />
        </mxCell>
        <mxCell id="n17s0" style="endArrow=block;html=1;strokeColor=#243746;strokeWidth=1.9500000000000002;rounded=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="56.0" y="385.0" />
            <mxPoint as="targetPoint" x="1344.0" y="385.0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n18" value="40 ms 后从第一项重新循环；每个时隙的 Header 都由主任务发送" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="388.62" y="398.087" width="622.76" height="36.825" />
        </mxCell>
        <mxCell id="n19" value="A_Status：每循环出现两次&lt;br&gt;更新周期 = 20 ms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="465.5" width="623.0" height="80.5" />
        </mxCell>
        <mxCell id="n20" value="B_Command / B_Status：各一次&lt;br&gt;更新周期 = 40 ms" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="721.0" y="465.5" width="623.0" height="80.5" />
        </mxCell>
        <mxCell id="n21" value="每个时隙还要容纳响应、间隔和时序裕量；帧传输耗时不等于业务端到端延迟。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1d8;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42.0" y="619.5" width="1316.0" height="50.4" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="07-sleep-wake" name="07  休眠与唤醒：唤醒请求之后仍要恢复调度">
    <mxGraphModel adaptiveColors="auto" page="1" pageWidth="1400" pageHeight="700" background="#ffffff" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="07  休眠与唤醒：唤醒请求之后仍要恢复调度" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=31.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="365.19" y="11.988" width="669.62" height="53.025" />
        </mxCell>
        <mxCell id="n3" value="协议状态与芯片电源模式分开管理；EN / SLP / WAKE 的名称及极性以数据手册为准。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#526477;fontFamily=Microsoft YaHei;fontSize=17.25;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="343.44" y="60.9" width="713.12" height="35.0" />
        </mxCell>
        <mxCell id="n4" value="正常通信&lt;br&gt;主节点运行调度表" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
