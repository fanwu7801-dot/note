        <mxCell id="n48" value="Break 不是普通的 0x00：8N1 的 0x00 只有 9 bit 连续低电平" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
