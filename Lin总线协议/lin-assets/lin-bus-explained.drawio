        </mxCell>
        <mxCell id="n49" value="LIN 使用 NRZ 异步串行；不使用 Manchester 编码。Sync 的交替边沿用于位时间同步。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1d8;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
