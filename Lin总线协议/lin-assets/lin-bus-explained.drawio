  <diagram id="03-frame" name="03  一帧 LIN = Header + Response">
    <mxGraphModel adaptiveColors="auto" page="1" pageWidth="1400" pageHeight="700" background="#ffffff" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n2" value="03  一帧 LIN = Header + Response" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=31.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="382.83" y="11.988" width="634.34" height="53.025" />
        </mxCell>
        <mxCell id="n3" value="以无条件帧为例；颜色表示发送职责，字段宽度不代表真实持续时间。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#526477;fontFamily=Microsoft YaHei;fontSize=17.25;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420.375" y="60.9" width="559.25" height="35.0" />
        </mxCell>
        <mxCell id="n4" value="Header：主任务发送" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="129.5" width="637.0" height="49.0" />
        </mxCell>
        <mxCell id="n5" value="Response：该帧的发布者发送" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="707.0" y="129.5" width="637.0" height="49.0" />
        </mxCell>
        <mxCell id="n6" value="Break&lt;br&gt;≥ 13 bit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1d8;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="196.0" width="210.0" height="108.5" />
        </mxCell>
        <mxCell id="n7" value="界定符&lt;br&gt;≥ 1 bit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="266.0" y="196.0" width="119.0" height="108.5" />
        </mxCell>
        <mxCell id="n8" value="Sync&lt;br&gt;0x55" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="385.0" y="196.0" width="154.0" height="108.5" />
        </mxCell>
        <mxCell id="n9" value="PID&lt;br&gt;6 bit ID&lt;br&gt;+ P0 / P1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="539.0" y="196.0" width="154.0" height="108.5" />
        </mxCell>
        <mxCell id="n10" value="Data 0 ... Data N−1&lt;br&gt;N = 1～8 字节" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="707.0" y="196.0" width="441.0" height="108.5" />
        </mxCell>
        <mxCell id="n11" value="Checksum&lt;br&gt;1 字节" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1148.0" y="196.0" width="196.0" height="108.5" />
        </mxCell>
        <mxCell id="n12s0" style="endArrow=block;html=1;strokeColor=#243746;strokeWidth=1.9500000000000002;rounded=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="63.0" y="343.0" />
            <mxPoint as="targetPoint" x="1337.0" y="343.0" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n13" value="时间方向 →；帧头与响应之间可有响应间隔，字节之间可有间隔" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="433.59" y="353.5" width="532.82" height="35.0" />
        </mxCell>
        <mxCell id="n14" value="主任务&lt;br&gt;按调度发送帧头" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=21.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="416.5" width="392.0" height="87.5" />
        </mxCell>
        <mxCell id="n15" value="所有相关节点&lt;br&gt;检查 PID，查本地帧配置" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0f3f7;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="504.0" y="416.5" width="392.0" height="87.5" />
        </mxCell>
        <mxCell id="n16" value="唯一发布者发送响应&lt;br&gt;订阅者接收并校验" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="952.0" y="416.5" width="392.0" height="87.5" />
        </mxCell>
        <mxCell id="n17s0" style="endArrow=block;html=1;strokeColor=#243746;strokeWidth=1.9500000000000002;rounded=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="448.0" y="459.9" />
            <mxPoint as="targetPoint" x="504.0" y="459.9" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n18s0" style="endArrow=block;html=1;strokeColor=#243746;strokeWidth=1.9500000000000002;rounded=0;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="896.0" y="459.9" />
            <mxPoint as="targetPoint" x="952.0" y="459.9" />
          </mxGeometry>
        </mxCell>
        <mxCell id="n19" value="发布者可以是主节点，也可以是指定从节点；订阅者可以有多个。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="405.0" y="534.587" width="590.0" height="36.825" />
        </mxCell>
        <mxCell id="n20" value="Header 不携带长度字段；LIN 2.x 的数据长度和发布 / 订阅关系来自 LDF 或静态配置。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1d8;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="42.0" y="619.5" width="1316.0" height="50.4" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
