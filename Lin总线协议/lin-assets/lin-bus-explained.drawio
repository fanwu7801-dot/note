        <mxCell id="n26" value="LIN 单线信号 + 节点间地参考；无条件帧的响应只有一个发布者" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="423.69" y="448.0" width="552.62" height="35.0" />
        </mxCell>
        <mxCell id="n27" value="显性 0：任一节点拉低 → 总线为低&lt;br&gt;隐性 1：所有节点释放 → 上拉为高" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4efff;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="56.0" y="507.5" width="616.0" height="73.5" />
        </mxCell>
        <mxCell id="n28" value="MCU 侧：3.3 V / 5 V 逻辑域（视芯片）&lt;br&gt;总线侧：VBAT 域；不能直连 MCU 引脚" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e4f5ec;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=19.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="728.0" y="507.5" width="616.0" height="73.5" />
        </mxCell>
        <mxCell id="n29" value="主节点通常有较强的上拉终端网络；不是照搬 CAN 两端 120 Ω 终端。" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff1d8;strokeColor=#243746;fontColor=#243746;fontFamily=Microsoft YaHei;fontSize=18.0;" vertex="1" parent="1">
