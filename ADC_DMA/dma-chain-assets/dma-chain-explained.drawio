        </mxCell>
        <mxCell id="data-c" parent="1" edge="1" source="buf-c" target="engine" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.5;exitY=0.9999999999999998;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;">
