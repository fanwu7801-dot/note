          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="src-c" parent="1" edge="1" source="desc-c" target="buf-c" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.5;exitY=0.9999999999999998;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="next-ab" parent="1" edge="1" source="desc-a" target="desc-b" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=1.0;exitY=0.48076923076923084;exitPerimeter=0;entryX=0.0;entryY=0.48076923076923084;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="next-bc" parent="1" edge="1" source="desc-b" target="desc-c" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=1.0;exitY=0.48076923076923084;exitPerimeter=0;entryX=0.0;entryY=0.48076923076923084;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="next-end" parent="1" edge="1" source="desc-c" target="end" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=1.0000000000000004;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.4999999999999998;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="data-a" parent="1" edge="1" source="buf-a" target="engine" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.5;exitY=0.9999999999999998;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="data-b" parent="1" edge="1" source="buf-b" target="engine" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.5;exitY=0.9999999999999998;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;">
