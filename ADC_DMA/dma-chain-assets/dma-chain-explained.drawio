  <diagram id="request-and-transfer" name="链表决定搬什么，请求推动什么时候搬">
    <mxGraphModel adaptiveColors="auto" page="1" pageScale="1" pageWidth="1400" pageHeight="700">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="链表决定搬什么，请求推动什么时候搬" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=42.4;">
          <mxGeometry x="105.0" y="12.249999999999948" width="1190" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="descriptor" parent="1" vertex="1" value="当前描述符&#10;源 / 目的 / 数量 / next" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=27.6;">
          <mxGeometry x="49.0" y="105.0" width="322.0" height="119.0" as="geometry" />
        </mxCell>
        <mxCell id="params" parent="1" vertex="1" value="当前段参数&#10;地址、宽度和剩余数量" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dff2e5;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=27.6;">
          <mxGeometry x="490" y="105.0" width="329.0" height="119.0" as="geometry" />
        </mxCell>
        <mxCell id="load-text" parent="1" vertex="1" value="装载" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="290.5" y="110.24999999999999" width="280" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="trigger" parent="1" vertex="1" value="外设 FIFO / 数据就绪&#10;产生 DMA 请求" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=27.6;">
          <mxGeometry x="49.0" y="311.5" width="322.0" height="115.5" as="geometry" />
        </mxCell>
        <mxCell id="transfer" parent="1" vertex="1" value="DMA 按参数搬运&#10;请求粒度由配置决定" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=27.6;">
          <mxGeometry x="490" y="311.5" width="329.0" height="115.5" as="geometry" />
        </mxCell>
        <mxCell id="destination" parent="1" vertex="1" value="数据到达目的地址&#10;本例：外设数据寄存器" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=27.6;">
          <mxGeometry x="980" y="311.5" width="371.0" height="115.5" as="geometry" />
        </mxCell>
        <mxCell id="request-text" parent="1" vertex="1" value="请求" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="290.5" y="313.25" width="280" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="payload-text" parent="1" vertex="1" value="数据" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="759.5" y="313.25" width="280" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="next" parent="1" vertex="1" value="段完成且有下一节点 → 硬件准备下一段" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dff2e5;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=23.3;">
          <mxGeometry x="434.0" y="525.0" width="441.0" height="77.0" as="geometry" />
        </mxCell>
        <mxCell id="caution" parent="1" vertex="1" value="没有有效请求，链表正确也可能不搬；预取和装载时机以手册为准。" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="0.0" y="631.75" width="1400" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="load" parent="1" edge="1" source="descriptor" target="params" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=1.0;exitY=0.5000000000000001;exitPerimeter=0;entryX=0.0;entryY=0.5000000000000001;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="request" parent="1" edge="1" source="trigger" target="transfer" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=1.0;exitY=0.4969696969696966;exitPerimeter=0;entryX=0.0;entryY=0.4969696969696966;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="config" parent="1" edge="1" source="params" target="transfer" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.4999999999999999;exitY=1.0000000000000002;exitPerimeter=0;entryX=0.4999999999999999;entryY=0.0;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="payload" parent="1" edge="1" source="transfer" target="destination" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.9999999999999998;exitY=0.4969696969696966;exitPerimeter=0;entryX=0.0;entryY=0.4969696969696966;entryPerimeter=0;">
