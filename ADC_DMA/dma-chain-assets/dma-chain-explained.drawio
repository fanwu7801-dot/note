<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="single-vs-chain" name="下一段参数，由 CPU 还是 DMA 装载？">
    <mxGraphModel adaptiveColors="auto" page="1" pageScale="1" pageWidth="1400" pageHeight="644">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="下一段参数，由 CPU 还是 DMA 装载？" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=42.4;">
          <mxGeometry x="0.0" y="12.249999999999948" width="1400" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="top" parent="1" vertex="1" value="普通单次 DMA：段间由 CPU 重新配置" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="0.0" y="68.25" width="1400" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="cpu-a" parent="1" vertex="1" value="CPU&#10;配置 A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="49.0" y="140" width="238.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="dma-a" parent="1" vertex="1" value="DMA&#10;搬运 A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="378.0" y="140" width="224.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="cpu-b" parent="1" vertex="1" value="CPU&#10;配置 B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="700" y="140" width="252.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="dma-b" parent="1" vertex="1" value="DMA&#10;搬运 B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="1050" y="140" width="245.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="bottom" parent="1" vertex="1" value="硬件链式 DMA：CPU 提前准备，DMA 自动接力" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="0.0" y="285.24999999999994" width="1400" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="prepare" parent="1" vertex="1" value="CPU 准备&#10;A → B 的链" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="49.0" y="357.0" width="280" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="chain-a" parent="1" vertex="1" value="DMA&#10;搬运 A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="420" y="357.0" width="224.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="load-b" parent="1" vertex="1" value="DMA 硬件&#10;装载 B 参数" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dff2e5;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="735.0" y="357.0" width="252.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="chain-b" parent="1" vertex="1" value="DMA&#10;搬运 B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="1078.0" y="357.0" width="266.0" height="105.0" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" value="两种方式的一段内部，都由 DMA 搬数据" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=29.7;">
          <mxGeometry x="0.0" y="512.75" width="1400" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="boundary" parent="1" vertex="1" value="箭头表示顺序，框宽不代表耗时；链式能力与更新字段以手册为准" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="0.0" y="572.2499999999999" width="1400" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="cpu-a-next" parent="1" edge="1" source="cpu-a" target="dma-a" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.9999999999999999;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dma-a-next" parent="1" edge="1" source="dma-a" target="cpu-b" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=1.0000000000000002;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cpu-b-next" parent="1" edge="1" source="cpu-b" target="dma-b" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.9999999999999999;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prepare-next" parent="1" edge="1" source="prepare" target="chain-a" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="chain-a-next" parent="1" edge="1" source="chain-a" target="load-b" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.9999999999999998;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="load-b-next" parent="1" edge="1" source="load-b" target="chain-b" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.9999999999999999;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="descriptor-and-data" name="描述符是搬运单，缓冲区是数据">
    <mxGraphModel adaptiveColors="auto" page="1" pageScale="1" pageWidth="1400" pageHeight="735">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="描述符是搬运单，缓冲区是数据" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=42.4;">
          <mxGeometry x="210.0" y="12.249999999999948" width="980" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="desc-a" parent="1" vertex="1" value="描述符 A&#10;src：缓冲区 A&#10;dst：同一外设寄存器&#10;count：256 个半字&#10;next：B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="49.0" y="101.5" width="315.0" height="182.0" as="geometry" />
        </mxCell>
        <mxCell id="buf-a" parent="1" vertex="1" value="缓冲区 A：512 字节" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=27.6;">
          <mxGeometry x="49.0" y="350" width="315.0" height="73.5" as="geometry" />
        </mxCell>
        <mxCell id="desc-b" parent="1" vertex="1" value="描述符 B&#10;src：缓冲区 B&#10;dst：同一外设寄存器&#10;count：256 个半字&#10;next：C" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="448.0" y="101.5" width="315.0" height="182.0" as="geometry" />
        </mxCell>
        <mxCell id="buf-b" parent="1" vertex="1" value="缓冲区 B：512 字节" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=27.6;">
          <mxGeometry x="448.0" y="350" width="315.0" height="73.5" as="geometry" />
        </mxCell>
        <mxCell id="desc-c" parent="1" vertex="1" value="描述符 C&#10;src：缓冲区 C&#10;dst：同一外设寄存器&#10;count：256 个半字&#10;next：结束" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fff0d6;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="847.0" y="101.5" width="315.0" height="182.0" as="geometry" />
        </mxCell>
        <mxCell id="buf-c" parent="1" vertex="1" value="缓冲区 C：512 字节" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=27.6;">
          <mxGeometry x="847.0" y="350" width="315.0" height="73.5" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" vertex="1" value="链结束" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#edf1f5;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=23.3;">
          <mxGeometry x="1246.0" y="154.0" width="112.0" height="77.0" as="geometry" />
        </mxCell>
        <mxCell id="ptr-label" parent="1" vertex="1" value="虚线：地址引用" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="972.9999999999999" y="295.75" width="490" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="engine" parent="1" vertex="1" value="DMA：按 A / B / C 顺序搬运" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dff2e5;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=23.3;">
          <mxGeometry x="448.0" y="528.5" width="315.0" height="77.0" as="geometry" />
        </mxCell>
        <mxCell id="peripheral" parent="1" vertex="1" value="固定目的：外设数据寄存器" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#dceafa;strokeColor=#243746;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="917.0" y="528.5" width="350" height="77.0" as="geometry" />
        </mxCell>
        <mxCell id="path-label" parent="1" vertex="1" value="数据" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="696.5" y="482.65" width="280" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="summary" parent="1" vertex="1" value="next 指向描述符；src 指向数据。三路源按段使用，不是同时搬运。" style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontFamily=Microsoft YaHei;fontColor=#243746;fontSize=25.5;">
          <mxGeometry x="0.0" y="656.25" width="1400" height="38.5" as="geometry" />
        </mxCell>
        <mxCell id="src-a" parent="1" edge="1" source="desc-a" target="buf-a" style="endArrow=block;endFill=1;html=0;strokeColor=#243746;strokeWidth=1.5;exitX=0.5;exitY=0.9999999999999998;exitPerimeter=0;entryX=0.5;entryY=0.0;entryPerimeter=0;dashed=1;">
